#Prometheus Config file:
#( it includes pormetheus, A targer macheine, blackbox )

global:
  scrape_interval: 15s

scrape_configs:
  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: "UB-04_Hardware"
    static_configs:
      - targets: ["192.168.x.x:9100"]

  - job_name: "blackbox_urls"
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
        - http://hasan-kachal.com
        - https://google.com
        - https://varzesh3.com
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox:9115
